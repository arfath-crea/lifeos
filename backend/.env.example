# Database Configuration
# Defaults to SQLite if omitted. Set to PostgreSQL connection string in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/lifeos_db
DATABASE_URL=sqlite:///./lifeos.db

# JWT Security
SECRET_KEY=lifeos_super_secret_jwt_key_change_in_production_2026

# Optional AI API keys (for advanced LLM conversational assistant)
GEMINI_API_KEY=
OPENAI_API_KEY=
